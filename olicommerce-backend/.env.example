PORT=4600
OLICOMMERCE_DATA_DIR=./data
OLICOMMERCE_STORE_NAME=Your Store
OLICOMMERCE_WEBHOOK_SECRET=

# Required to send recovery emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourstore.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=you@yourstore.com
SMTP_REJECT_UNAUTHORIZED=true

# Optional: enables AI-rewritten recovery emails AND the AI-assisted
# tier of the AI Support Assistant (server/supportAssistant.js) — both
# share this same key. Leave unset and both features still work fully:
# recovery emails use the real (non-AI) template, and the assistant
# answers from its real knowledge base, escalating to a support ticket
# when it isn't confident. Works with OpenAI, or any OpenAI-compatible
# provider, including free ones like Groq (https://console.groq.com/keys
# — no credit card required).
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

OLICOMMERCE_SESSION_TTL_HOURS=12
OLICOMMERCE_MAX_FAILED_ATTEMPTS=5
OLICOMMERCE_LOCKOUT_WINDOW_MINUTES=15
ALLOWED_ORIGIN=*
