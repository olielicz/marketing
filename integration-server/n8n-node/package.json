{
  "name": "n8n-nodes-oli-tools",
  "version": "1.0.0",
  "description": "n8n community node for OliOps, OliCommerce, OliFlow, OliExplore, Oli-Locator, and OliSalesTrack.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/olielicz/marketing/tree/main/integration-server/n8n-node",
  "author": {
    "name": "olielicz"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials package.json",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/OliApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Oli/Oli.node.js",
      "dist/nodes/Oli/OliTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "n8n-workflow": "^1.60.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.10"
  }
}
