# Copy this file to .env and fill in real values before deploying.
# Nothing in this file has a working default except PORT - nothing will
# authenticate against a real platform until you provide real credentials.

# --- Core server ---
PORT=3000
ALLOWED_ORIGIN=*
OLI_API_SECRET=change-me-to-a-random-32+-character-string
OLI_DATA_DIR=./data

# --- Zapier OAuth (only needed if you enable OAuth2 auth for Zapier;
#     the shipped Zapier app uses simpler bearer-token "custom" auth by
#     default - see zapier-app/NOTES.md) ---
ZAPIER_CLIENT_ID=
ZAPIER_CLIENT_SECRET=

# --- Make.com OAuth ---
MAKE_CLIENT_ID=
MAKE_CLIENT_SECRET=

# --- n8n OAuth (only relevant for self-hosted n8n instances that support
#     OAuth2; most n8n users will just use the API-token credential in
#     n8n-node/credentials/OliApi.credentials.ts instead) ---
N8N_CLIENT_ID=
N8N_CLIENT_SECRET=
N8N_BASE_URL=

# --- GoHighLevel ---
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_WEBHOOK_SECRET=
