PORT=4500
OLIOPS_DATA_DIR=./data
OLIOPS_BUSINESS_NAME=Your Business
OLIOPS_BUSINESS_EMAIL=you@yourbusiness.com
OLIOPS_SESSION_TTL_HOURS=12
OLIOPS_MAX_FAILED_ATTEMPTS=5
OLIOPS_LOCKOUT_WINDOW_MINUTES=15
ALLOWED_ORIGIN=*

# Optional: enables the AI-assisted tier of the AI Support Assistant
# (see server/supportAssistant.js and README.md's "Setting up the AI
# Support Assistant" section). Leave unset and the assistant still works
# fully — it just answers from the real knowledge base instead, and
# escalates to a support ticket when that's not confident. Works with
# OpenAI itself, or any OpenAI-compatible provider, including free ones
# like Groq (https://console.groq.com/keys — no credit card required).
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
