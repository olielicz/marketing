# Port the activation server listens on
PORT=4100

# Recommended: URL of your running admin-auth server (see ../admin-auth).
# Admin endpoints (create/view/revoke licenses) verify the caller's bearer
# token against this service's single owner account instead of a static
# shared secret — sessions can be individually revoked, logins are
# rate-limited, and passwords are real scrypt hashes. See
# ../admin-auth/README.md for setup.
OLI_ADMIN_AUTH_URL=http://localhost:4300

# Optional break-glass fallback ONLY — a static shared secret, for scripted/
# CI use where running a full login flow is impractical. Leave unset for
# routine use; every routine admin action should go through
# OLI_ADMIN_AUTH_URL above instead, so it's tied to a real, revocable
# session rather than a secret that can't be individually revoked.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# How many days a client can keep working offline on a cached, signed token
# before it must successfully re-check in with the server.
OLI_LICENSE_OFFLINE_GRACE_DAYS=14

# Default device cap for newly generated licenses (can be overridden per-license).
OLI_LICENSE_DEFAULT_MAX_DEVICES=5

# Where license/device data is persisted (a plain JSON file — fine at this scale).
OLI_LICENSE_DATA_DIR=./data
