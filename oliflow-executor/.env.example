# Port this executor listens on
PORT=4400

# Recommended: URL of your running admin-auth server (see ../admin-auth).
# POST /api/execute verifies the caller's bearer token against this
# service's single owner account instead of a static shared secret.
# See ../admin-auth/README.md for setup.
OLI_ADMIN_AUTH_URL=http://localhost:4300

# Optional break-glass fallback ONLY — see ../admin-auth/README.md for
# why a revocable session is safer than a static shared secret.
ADMIN_TOKEN=

# CORS origin for the OliFlow app's browser-side fetch() calls to this
# executor. * is fine for a self-hosted single-owner tool.
ALLOWED_ORIGIN=*

# Set to 1 ONLY if you intentionally want http_request nodes to be able
# to target localhost/private network addresses (the default blocks this
# as an SSRF guard — see server/handlers/httpRequestNode.js).
OLIFLOW_ALLOW_PRIVATE_NETWORK_REQUESTS=

# Per-request timeout for http_request nodes, in milliseconds.
OLIFLOW_HTTP_NODE_TIMEOUT_MS=15000
