# Port the Trend Radar server listens on.
# FIX: was 4300, which collides directly with admin-auth's own default
# port (also 4300 - see ../admin-auth/.env.example). Every other Oli
# backend (licensing 4100, olisalestrack-sync 4200, admin-auth 4300,
# oliflow-executor 4400, oliops-backend 4500, olicommerce-backend 4600)
# already has its own dedicated port - 4700 is the next free one.
PORT=4700

# GIPHY API key (free tier: developers.giphy.com -> Create App -> API key).
# Required for the "memes/GIFs" part of the feed. Beta keys are rate-limited
# to 100 calls/hour, which is plenty for a 5-minute auto-refresh interval
# (12 calls/hour) with headroom for manual "Refresh now" clicks.
GIPHY_API_KEY=

# YouTube Data API v3 key (free tier: console.cloud.google.com -> enable
# "YouTube Data API v3" -> Credentials -> Create API key).
# Required for the "trending video" part of the feed. The free daily quota
# (10,000 units/day; a videos.list call costs ~1-5 units) comfortably covers
# a 5-minute auto-refresh interval.
YOUTUBE_API_KEY=

# ISO 3166-1 alpha-2 country code for YouTube's regional "most popular" chart.
YOUTUBE_REGION_CODE=US

# How often the server auto-refreshes both sources in the background, in
# milliseconds. Default is 5 minutes. Lower this cautiously — going below
# ~2 minutes risks hitting GIPHY's beta-key rate limit (100 calls/hour).
REFRESH_INTERVAL_MS=300000

# CORS: which origin(s) the oliexplore/trends/ frontend is served from.
# Use "*" for local testing; set to your real domain (e.g.
# https://workitlikeapro.com) once deployed, to avoid an open CORS policy.
ALLOWED_ORIGIN=*
