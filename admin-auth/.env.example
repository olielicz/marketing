# Port the admin-auth server listens on
PORT=4300

# How long a session token stays valid after login, in hours. Kept short by
# default because these tokens are also verified against a server-side
# revocation list on every check — see README.md "Security model".
OLI_ADMIN_SESSION_TTL_HOURS=12

# Max failed login attempts allowed within OLI_ADMIN_LOCKOUT_WINDOW_MINUTES
# before the account is temporarily locked out. Protects the single owner
# account against password-guessing.
OLI_ADMIN_MAX_FAILED_ATTEMPTS=5
OLI_ADMIN_LOCKOUT_WINDOW_MINUTES=15

# Where account/session/keys data is persisted (plain JSON files + PEM
# keypair — fine at this scale: one admin account).
OLI_ADMIN_DATA_DIR=./data

# Restricts which origins the login page's fetch() calls are allowed from,
# if you serve public/login.html from a different host than this API.
# Comma-separated, or * for any (fine for a self-hosted single-owner tool).
ALLOWED_ORIGIN=*
