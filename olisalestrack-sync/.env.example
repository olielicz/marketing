# Port the sync server listens on
PORT=4200

# Recommended: URL of your running admin-auth server (see ../admin-auth).
# GET /api/events verifies the caller's bearer token against this
# service's single owner account instead of a static shared secret —
# sessions can be individually revoked, logins are rate-limited, and
# passwords are real scrypt hashes. See ../admin-auth/README.md for setup.
OLI_ADMIN_AUTH_URL=http://localhost:4300

# Optional break-glass fallback ONLY — a static shared secret, for scripted
# use where running a full login flow is impractical. Leave unset for
# routine use; every routine admin call should go through
# OLI_ADMIN_AUTH_URL above instead.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN=

# Stripe webhook signing secret (Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret).
# Required to verify POST /webhooks/stripe. Requests without a valid signature are rejected.
STRIPE_WEBHOOK_SECRET=

# Shopify webhook shared secret (Shopify Admin -> Settings -> Notifications -> Webhooks, or your app's API secret).
# Required to verify POST /webhooks/shopify. Requests without a valid signature are rejected.
SHOPIFY_WEBHOOK_SECRET=

# PayPal webhook ID (PayPal Developer Dashboard -> your app -> Webhooks -> the specific webhook's ID, looks like
# "WH-XXXXXXXXX"). Combined with PAYPAL_CLIENT_ID/SECRET below, this lets the server call PayPal's own
# verify-webhook-signature API. If any of the three PayPal vars are left blank, PayPal webhook signature
# verification is SKIPPED with a loud warning at startup — do not leave this blank in production.
PAYPAL_WEBHOOK_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal API base — sandbox for testing, live for production.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# WooCommerce webhook secret (WooCommerce Admin -> Settings -> Advanced ->
# Webhooks -> your webhook -> Secret). Uses the exact same HMAC-SHA256/
# base64 scheme as Shopify above. Required to verify POST /webhooks/woocommerce.
WOOCOMMERCE_WEBHOOK_SECRET=

# Amazon Selling Partner API (SP-API) credentials. Unlike the providers
# above, Amazon has no simple webhook+shared-secret scheme, so this service
# POLLS the SP-API Orders API on a timer instead of exposing a
# POST /webhooks/amazon route — see server/amazon.js's header comment.
# Get these from Amazon's Developer Central after registering an SP-API
# application (Login-With-Amazon client) and completing the authorization
# flow to obtain a long-lived refresh token.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
# The marketplace to poll (e.g. ATVPDKIKX0DER = US). See Amazon's
# Marketplace IDs reference for your country's value.
AMAZON_MARKETPLACE_ID=
# SP-API regional endpoint — the default below is North America; use
# https://sellingpartnerapi-eu.amazon.com for Europe/UK or
# https://sellingpartnerapi-fe.amazon.com for Far East, as appropriate.
AMAZON_SP_API_BASE=https://sellingpartnerapi-na.amazon.com
# How often (ms) to poll for new/updated Amazon orders. Default: 5 minutes.
AMAZON_POLL_INTERVAL_MS=300000

# Where normalized event data is persisted (a plain JSON file — fine at this scale).
OLI_SYNC_DATA_DIR=./data
