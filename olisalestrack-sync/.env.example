# Port the sync server listens on
PORT=4200

# Required. Long random string — protects the pull API (GET /api/events).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN=

# Stripe webhook signing secret (Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret).
# Required to verify POST /webhooks/stripe. Requests without a valid signature are rejected.
STRIPE_WEBHOOK_SECRET=

# Shopify webhook shared secret (Shopify Admin -> Settings -> Notifications -> Webhooks, or your app's API secret).
# Required to verify POST /webhooks/shopify. Requests without a valid signature are rejected.
SHOPIFY_WEBHOOK_SECRET=

# PayPal webhook ID (PayPal Developer Dashboard -> your app -> Webhooks -> the specific webhook's ID, looks like
# "WH-XXXXXXXXX"). Combined with PAYPAL_CLIENT_ID/SECRET below, this lets the server call PayPal's own
# verify-webhook-signature API. If any of the three PayPal vars are left blank, PayPal webhook signature
# verification is SKIPPED with a loud warning at startup — do not leave this blank in production.
PAYPAL_WEBHOOK_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal API base — sandbox for testing, live for production.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Where normalized event data is persisted (a plain JSON file — fine at this scale).
OLI_SYNC_DATA_DIR=./data
